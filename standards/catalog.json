{
  "schema_version": 1,
  "institutions": [
    {
      "code": "ASME",
      "name": "American Society of Mechanical Engineers",
      "region": "US",
      "website": "https://www.asme.org",
      "description": "Boiler and pressure vessel, piping and flange standards."
    },
    {
      "code": "ANSI",
