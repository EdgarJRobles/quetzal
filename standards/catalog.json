  "families": {
    "Pipe": {
      "prefix": "Pipe",
      "description": "Pipe outside diameter and wall thickness",
      "dimensions": [
        "PSize",
        "OD",
        "thk"
      ],
      "rules": [
        {
          "match": "^SCH-(5S|10S|40S|80S)$",
          "standard": "ASME B36.19M",
          "notes": "Stainless steel schedule"
        },
        {
          "match": "^SCH-",
          "standard": "ASME B36.10M",
          "notes": "Carbon steel schedule"
        },
        {
          "match": "^Conduit",
          "standard": "QUETZAL-GENERIC",
          "notes": "Electrical conduit; not an ASME pipe schedule"
        },
        {
          "match": "^REBARS$",
          "standard": "ASTM A615",
          "notes": "Reinforcement bar data stored in the pipe family"
        }
      ]
    },
    "Elbow": {
      "prefix": "Elbow",
      "description": "Buttweld, socket-weld and DIN elbows",
      "dimensions": [
        "PSize",
        "OD",
        "thk",
        "BendAngle",
        "BendRadius",
        "A",
        "C",
        "D",
        "E",
        "G",
        "Conn"
      ],
      "rules": [
        {
          "match": "^(3000|6000|9000)lb_SW$",
          "standard": "ASME B16.11",
          "notes": "Forged socket-weld elbow"
        },
        {
          "match": "^DIN_1626_90$",
          "standard": "DIN 1626",
          "notes": "DIN steel pipe elbow"
        },
        {
          "match": "^Conduit",
          "standard": "QUETZAL-GENERIC",
          "notes": "Electrical conduit elbow"
        },
        {
          "match": "^SCH-",
          "standard": "ASME B16.9",
          "notes": "Buttweld elbow"
        }
      ]
    },
    "Tee": {
      "prefix": "Tee",
      "description": "Buttweld, socket-weld and reducing tees",
      "dimensions": [
        "PSize",
        "PSizeBranch",
        "OD",
        "OD2",
        "thk",
        "thk2",
        "A",
        "C",
        "D",
        "E",
        "G",
        "M",
        "Conn"
      ],
      "rules": [
        {
          "match": "^(3000|6000|9000)lb_SW$",
          "standard": "ASME B16.11",
          "notes": "Forged socket-weld tee"
        },
        {
          "match": "^SCH-",
          "standard": "ASME B16.9",
          "notes": "Buttweld tee"
        }
      ]
    },
    "Cap": {
      "prefix": "Cap",
      "description": "Buttweld and socket-weld caps",
      "dimensions": [
        "PSize",
        "OD",
        "thk",
        "A",
        "C",
        "E",
        "Conn"
      ],
      "rules": [
        {
          "match": "^(3000|6000|9000)lb_SW$",
          "standard": "ASME B16.11",
          "notes": "Forged socket-weld cap"
        },
        {
          "match": "^SCH-",
          "standard": "ASME B16.9",
          "notes": "Buttweld cap"
        }
      ]
    },
    "Reduct": {
      "prefix": "Reduct",
      "description": "Concentric and eccentric reducers",
      "dimensions": [
        "PSize",
        "PSize2",
        "OD",
        "OD2",
        "thk",
        "thk2",
        "H",
        "Source"
      ],
      "rules": [
        {
          "match": "^SCH-",
          "standard": "ASME B16.9",
          "notes": "Buttweld reducer"
        }
      ]
    },
    "Flange": {
      "prefix": "Flange",
      "description": "ASME, DIN and PN flanges",
      "dimensions": [
        "PSize",
        "FlangeType",
        "D",
        "d",
        "df",
        "f",
        "t",
        "n",
        "trf",
        "drf",
        "twn",
        "dwn",
        "ODp",
        "R",
        "T1",
        "B2",
        "Y",
        "FClass",
        "BD",
        "B1*",
        "kg",
        "ldrf",
        "ltrf",
        "t1"
      ],
      "rules": [
        {
          "match": "^ASME-(?P<connection>[A-Z]+)-(?P<face>[A-Z]+)-(?P<pressure_class>[0-9]+lb)$",
          "standard": "ASME B16.5",
          "notes": "ASME B16.5 flange"
        },
        {
          "match": "^DIN-PN(?P<pressure_class>[0-9]+)$",
          "standard": "DIN 2543",
          "notes": "DIN PN16 slip-on flange"
        },
        {
          "match": "^PN(?P<pressure_class>[0-9]+)-WN$",
          "standard": "EN 1092-1",
          "notes": "PN weld-neck flange",
          "fields": {
            "connection": "WN",
            "face": "RF"
          }
        },
        {
          "match": "^PN(?P<pressure_class>[0-9]+)-RF$",
          "standard": "EN 1092-1",
          "notes": "PN raised-face flange",
          "fields": {
            "face": "RF"
          }
        }
      ]
    },
    "Valve": {
      "prefix": "Valve",
      "description": "Ball, gate, check, plug, knife-gate and pinch valves",
      "dimensions": [
        "PSize",
        "VType",
        "ODBody",
        "ID",
        "H",
        "OD",
        "E",
        "Conn",
        "Kv",
        "BottomH",
        "TopH",
        "WheelD"
      ],
      "rules": [
        {
          "match": "^(Ball|Gate|Check|Plug)_",
          "standard": "ASME B16.34",
          "notes": "Valve pressure-temperature and body standard; see also API 6D"
        },
        {
          "match": "^Ball-Threaded$",
          "standard": "API 608",
          "notes": "Threaded metal ball valve"
        }
      ]
    },
    "Gasket": {
      "prefix": "Gasket",
      "description": "Spiral-wound and ring-joint gaskets",
      "dimensions": [
        "PSize",
        "IRID",
        "SEID",
        "SEOD",
        "CROD",
        "SEthk",
        "Rthk"
      ],
      "rules": [
        {
          "match": ".*",
          "standard": "ASME B16.20",
          "notes": "Metallic gasket dimensions"
        }
      ]
    },
    "Bolt": {
      "prefix": "Bolt",
      "description": "Flange bolting",
      "dimensions": [
        "PSize",
        "dBolt",
        "dNut",
        "df",
        "lBolt",
        "n",
        "tNut"
      ],
      "rules": [
        {
          "match": ".*",
